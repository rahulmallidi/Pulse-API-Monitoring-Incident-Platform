{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "KAFKA_BROKERS",
    "KAFKA_CLIENT_ID",
    "REGION",
    "CORS_ORIGIN",
    "CORS_ALLOW_VERCEL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_API_SSE_URL",
    "KAFKAJS_NO_PARTITIONER_WARNING",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
