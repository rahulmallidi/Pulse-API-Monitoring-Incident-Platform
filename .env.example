# Local defaults (host-mode). For Vercel, set these in the project Environment Variables UI.

DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pulse
API_PORT=3000
PROBE_PORT=3001
SCHEDULER_PORT=3002
INGESTOR_PORT=3003
ALERTER_PORT=3004
WEB_PORT=3005
CORS_ORIGIN=http://localhost:3005,http://127.0.0.1:3005
# Set true when the dashboard is hosted on Vercel (allows https://*.vercel.app)
CORS_ALLOW_VERCEL=false
REGION=all

# Dashboard → API (prefer one base URL; path-specific overrides optional)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_SSE_URL=
NEXT_PUBLIC_CHECKS_API_URL=
NEXT_PUBLIC_INCIDENTS_API_URL=
NEXT_PUBLIC_LATENCY_SERIES_API_URL=
NEXT_PUBLIC_METRICS_SUMMARY_API_URL=
NEXT_PUBLIC_HEATMAP_API_URL=
NEXT_PUBLIC_REGIONAL_API_URL=
NEXT_PUBLIC_NOTIFIERS_API_URL=

# Optional alert delivery (alerter)
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
